{
  "name": "arx-convert",
  "version": "14.0.1",
  "description": "Converts various Arx Fatalis formats to JSON or YAML and back",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "bin": {
    "arx-convert": "dist/bin/convert.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils": {
      "default": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./types": {
      "default": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json && arx-lib-rewrite-declaration-imports && chmod +x dist/bin/convert.js",
    "build:watch": "nodemon --watch src --exec \"npm run build\" --ext ts",
    "lint": "rm -f xo.config.mjs && xo --ignore 'xo.config.mjs'",
    "lint:watch": "nodemon --watch src --exec \"npm run lint\" --ext ts",
    "test": "arx-lib-test 'tests/*.test.ts'",
    "schemas:build": "node scripts/schemas.ts build",
    "schemas:check": "node scripts/schemas.ts check",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run schemas:check && rm -rf dist && npm run build && npm run schemas:build",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.json",
    "pretest": "npm run build && npm run schemas:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arx-tools/arx-convert.git"
  },
  "author": "Lajos Meszaros <m_lajos@hotmail.com>",
  "contributors": [
    {
      "name": "DeepSeek Harness (AI coding agent) using DeepSeek-V41-Flash"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arx-tools/arx-convert/issues"
  },
  "homepage": "https://github.com/arx-tools/arx-convert#readme",
  "dependencies": {
    "minimist-lite": "^2.3.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@arx-tools/config": "file:../arx-tools-config",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.14",
    "pre-commit": "^2.0.0",
    "type-fest": "^4.40.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "xo": "^5.0.1"
  },
  "keywords": [
    "arx-fatalis"
  ],
  "pre-commit": {
    "run": [
      "lint",
      "typecheck",
      "test"
    ]
  },
  "prettier": "@arx-tools/config/prettier"
}
